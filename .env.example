# Configuración de ambiente local para desarrollo
# Copia este archivo a .env y configura tus valores

# Para usar .env local en lugar de AWS Parameter Store
USE_LOCAL_ENV=true 

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lbtechdev

# JWT Secret (genera uno único para tu ambiente)
SECRET_KEY=your-secret-key-here

# Email Configuration
EMAIL_FROM=soporte@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_PORT=587
SMTP_CLIENTE=smtp.office365.com

# Application Configuration
MONTH_INTERVAL=6

# Deploy/App version shown in /health endpoints
APP_VERSION=dev
APP_COMMIT=local
DEPLOY_ID=local
