# Configuración de ambiente local para desarrollo
# Copia este archivo a .env y configura tus valores
# Al ejecutar go run . desde la raíz del repo, main.go carga .env con godotenv.

# Para usar .env local en lugar de AWS Parameter Store
USE_LOCAL_ENV=true

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# Atlas (caracteres especiales en la URI): entre comillas, p. ej.
# MONGO_URI="mongodb+srv://user:pass@cluster.../lbtechdev?retryWrites=true&w=majority"
MONGO_DB=lbtechdev

# JWT Secret (genera uno único para tu ambiente)
SECRET_KEY=your-secret-key-here

# Email Configuration (Gmail: usar contraseña de aplicación, no la cuenta normal)
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_PORT=587
SMTP_CLIENTE=smtp.gmail.com

# Optional: public HTTPS URL to the tracking email logo (Gmail-friendly). If unset, the embedded PNG is sent as cid: inline.
# TRACKING_LOGO_URL=https://example.com/static/lbonetrack_logo.png

# Move tracking_id format: YYMMDD + 3-digit daily sequence (UTC), max 999/day. Counter collection: move_tracking_id_sequences.
#
# Move report PDF (Chrome headless): path to chrome/chromium binary if not on PATH (Linux servers / Docker).
# Debian/Ubuntu package "chromium" is usually /usr/bin/chromium (set automatically in the repo Dockerfile).
# CHROME_PATH=/usr/bin/chromium
# Set to true to skip PDF generation (e.g. CI without Chrome).
# TRACKING_SKIP_MOVE_PDF=false

# Move-report local copies (PDF only): default folder is ./move-report-debug
# under the process working directory (start the API from the repo root). Override path or set to
# none to disable: TRACKING_MOVE_REPORT_DEBUG_DIR=none
# TRACKING_MOVE_REPORT_DEBUG_DIR=

# Application Configuration
MONTH_INTERVAL=6

# Deploy/App version shown in /health endpoints
APP_VERSION=dev
APP_COMMIT=local
DEPLOY_ID=local
