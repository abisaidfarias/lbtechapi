# Configuración de ambiente local para desarrollo
# Copia este archivo a .env y configura tus valores
# Al ejecutar go run . desde la raíz del repo, main.go carga .env con godotenv.

# Para usar .env local en lugar de AWS Parameter Store
USE_LOCAL_ENV=true

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# Atlas (caracteres especiales en la URI): entre comillas, p. ej.
# MONGO_URI="mongodb+srv://user:pass@cluster.../lbtechdev?retryWrites=true&w=majority"
MONGO_DB=lbtechdev

# JWT Secret (genera uno único para tu ambiente)
SECRET_KEY=your-secret-key-here

# Email Configuration (Gmail: usar contraseña de aplicación, no la cuenta normal)
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_PORT=587
SMTP_CLIENTE=smtp.gmail.com
# Amazon SES (optional): set USE_SES_SMTP=true and configure SMTP_USER + SES host/password.
# Leave USE_SES_SMTP=false (default) for Office365 / legacy SMTP (login user = EMAIL_FROM).
USE_SES_SMTP=false
SMTP_USER=your-smtp-username-here

# Optional: public HTTPS URL to the tracking email logo (Gmail-friendly). If unset, the embedded PNG is sent as cid: inline.
# TRACKING_LOGO_URL=https://example.com/static/lbonetrack_logo.png

# Move tracking_id format: YYMMDD + 3-digit daily sequence (UTC), max 999/day. Counter collection: move_tracking_id_sequences.
#
# Move report PDF (Chrome headless): path to chrome/chromium binary if not on PATH (Linux servers / Docker).
# Debian/Ubuntu package "chromium" is usually /usr/bin/chromium (set automatically in the repo Dockerfile).
# CHROME_PATH=/usr/bin/chromium
# Per-attempt headless Chrome timeout used in the SLOW background phase
# (resilient retries until the PDF lands in S3 and document_url is set).
# Default 600s. Increase if dev/EB instances are slow.
# MOVE_REPORT_PDF_TIMEOUT_SEC=900
# Per-attempt headless Chrome timeout used in the FAST phase (the one that
# decides whether the notification email carries a download link or just a
# pending-note). Keep it short (default 90s) so the email is not held back.
# MOVE_REPORT_PDF_FAST_TIMEOUT_SEC=90
# Set to true to skip PDF generation (e.g. CI without Chrome).
# TRACKING_SKIP_MOVE_PDF=false

# Move report PDF reliability (link instead of attachment strategy):
# Fast retries that try to produce the PDF before the email goes out so it can
# include the download link. If they all fail the email is sent with a fallback
# note and the slow phase continues in background.
# MOVE_REPORT_PDF_FAST_ATTEMPTS=3
# Slow background retries that keep trying to generate + upload the PDF so
# tracking_log.document_url is eventually populated (the platform reads it when
# users consult the record). Backoff is exponential: base * 2^(n-1), capped.
# MOVE_REPORT_PDF_SLOW_ATTEMPTS=8
# MOVE_REPORT_PDF_SLOW_BACKOFF_BASE_SEC=30
# MOVE_REPORT_PDF_SLOW_MAX_BACKOFF_SEC=1800
# Fallback note rendered in the email when the fast phase did not produce the
# PDF in time (link will appear in-platform once the slow phase succeeds).
# MOVE_REPORT_PENDING_NOTE=The PDF report is being generated and will be available in the LB Technology platform shortly.

# Optional S3 prefix folder for move-report PDF keys (no leading/trailing slash).
# Example keys: move-reports/C-354857091234567-260504001.pdf, move-reports/MC-260504001.pdf
# MOVE_REPORT_S3_PREFIX=move-reports

# Move-report local copies (PDF only): default folder is ./move-report-debug
# under the process working directory (start the API from the repo root). Override path or set to
# none to disable: TRACKING_MOVE_REPORT_DEBUG_DIR=none
# TRACKING_MOVE_REPORT_DEBUG_DIR=

# Application Configuration
MONTH_INTERVAL=6

# Deploy/App version shown in /health endpoints
APP_VERSION=dev
APP_COMMIT=local
DEPLOY_ID=local
