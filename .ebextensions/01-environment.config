commands:
  01_get_secrets:
    command: |
      #!/bin/bash
      # Load secrets from Parameter Store and set as environment variables
      SECRET_KEY=$(aws ssm get-parameter --name /lbtechapi/dev/SECRET_KEY --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      MONGO_URI=$(aws ssm get-parameter --name /lbtechapi/dev/MONGO_URI --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      EMAIL_PASSWORD=$(aws ssm get-parameter --name /lbtechapi/dev/EMAIL_PASSWORD --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      
      # Create env file for Docker
      cat > /var/app/current/.env << EOF
      USE_LOCAL_ENV=true
      ENVIRONMENT=dev
      SECRET_KEY=$SECRET_KEY
      MONGO_URI=$MONGO_URI
      MONGO_DB=lbtechdev
      EMAIL_FROM=soporte@lbtechnology-la.com
      EMAIL_PASSWORD=$EMAIL_PASSWORD
      EMAIL_PORT=587
      SMTP_CLIENTE=smtp.office365.com
      MONTH_INTERVAL=6
      EOF

option_settings:
  aws:elasticbeanstalk:application:environment:
    USE_LOCAL_ENV: "true"
    ENVIRONMENT: "dev"

