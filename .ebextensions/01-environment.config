commands:
  01_get_secrets:
    command: |
      #!/bin/bash
      # Load secrets from Parameter Store and set as environment variables
      ENV="${ENVIRONMENT:-dev}"
      SSM="/lbtechapi/${ENV}"
      SECRET_KEY=$(aws ssm get-parameter --name ${SSM}/SECRET_KEY --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      MONGO_URI=$(aws ssm get-parameter --name ${SSM}/MONGO_URI --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      MONGO_DB=$(aws ssm get-parameter --name ${SSM}/MONGO_DB --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "lbtechdev")
      EMAIL_PASSWORD=$(aws ssm get-parameter --name ${SSM}/EMAIL_PASSWORD --with-decryption --region us-east-1 --query 'Parameter.Value' --output text)
      SMTP_USER=$(aws ssm get-parameter --name ${SSM}/SMTP_USER --with-decryption --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "")
      USE_SES_SMTP=$(aws ssm get-parameter --name ${SSM}/USE_SES_SMTP --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "false")
      EMAIL_FROM=$(aws ssm get-parameter --name ${SSM}/EMAIL_FROM --region us-east-1 --query 'Parameter.Value' --output text)
      SMTP_CLIENTE=$(aws ssm get-parameter --name ${SSM}/SMTP_CLIENTE --region us-east-1 --query 'Parameter.Value' --output text)
      EMAIL_PORT=$(aws ssm get-parameter --name ${SSM}/EMAIL_PORT --region us-east-1 --query 'Parameter.Value' --output text)
      FRONTEND_BASE_URL=$(aws ssm get-parameter --name ${SSM}/FRONTEND_BASE_URL --region us-east-1 --query 'Parameter.Value' --output text)
      PASSWORD_TOKEN_TTL_HOURS=$(aws ssm get-parameter --name ${SSM}/PASSWORD_TOKEN_TTL_HOURS --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "48")
      IMEI_INFO_API_KEY=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_API_KEY --with-decryption --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "")
      IMEI_INFO_BASE_URL=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_BASE_URL --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "https://dash.imei.info/api")
      IMEI_INFO_SERVICE=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_SERVICE --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "0")
      IMEI_INFO_MAX_PER_USER_DAY=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_MAX_PER_USER_DAY --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "40")
      IMEI_INFO_MAX_GLOBAL_DAY=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_MAX_GLOBAL_DAY --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "40")
      IMEI_INFO_COOLDOWN_SAME_IMEI_SEC=$(aws ssm get-parameter --name ${SSM}/IMEI_INFO_COOLDOWN_SAME_IMEI_SEC --region us-east-1 --query 'Parameter.Value' --output text 2>/dev/null || echo "60")
      
      # Create env file for Docker
      cat > /var/app/current/.env << EOF
      USE_LOCAL_ENV=true
      ENVIRONMENT=${ENV}
      SECRET_KEY=$SECRET_KEY
      MONGO_URI=$MONGO_URI
      MONGO_DB=$MONGO_DB
      EMAIL_FROM=$EMAIL_FROM
      EMAIL_PASSWORD=$EMAIL_PASSWORD
      EMAIL_PORT=$EMAIL_PORT
      SMTP_CLIENTE=$SMTP_CLIENTE
      SMTP_USER=$SMTP_USER
      USE_SES_SMTP=$USE_SES_SMTP
      FRONTEND_BASE_URL=$FRONTEND_BASE_URL
      PASSWORD_TOKEN_TTL_HOURS=$PASSWORD_TOKEN_TTL_HOURS
      IMEI_INFO_API_KEY=$IMEI_INFO_API_KEY
      IMEI_INFO_BASE_URL=$IMEI_INFO_BASE_URL
      IMEI_INFO_SERVICE=$IMEI_INFO_SERVICE
      IMEI_INFO_MAX_PER_USER_DAY=$IMEI_INFO_MAX_PER_USER_DAY
      IMEI_INFO_MAX_GLOBAL_DAY=$IMEI_INFO_MAX_GLOBAL_DAY
      IMEI_INFO_COOLDOWN_SAME_IMEI_SEC=$IMEI_INFO_COOLDOWN_SAME_IMEI_SEC
      MONTH_INTERVAL=6
      EOF

option_settings:
  aws:elasticbeanstalk:application:environment:
    USE_LOCAL_ENV: "true"
    ENVIRONMENT: "dev"

