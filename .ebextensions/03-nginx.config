files:
    "/etc/nginx/conf.d/proxy.conf" :
        mode: "000644"
        owner: root
        group: root
        content: |
           client_max_body_size 50M;
           proxy_connect_timeout 360s;
           proxy_send_timeout 360s;
           proxy_read_timeout 360s;

commands:
  reload_nginx:
    command: "service nginx reload 2>/dev/null || nginx -s reload 2>/dev/null || true"
    ignoreErrors: true
