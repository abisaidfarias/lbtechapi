{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug API (lbtechapi)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "env": {
                "USE_LOCAL_ENV": "true",
                "SECRET_KEY": "dev-secret-local",
                "MONGO_URI": "mongodb://127.0.0.1:27017",
                "MONGO_DB": "lbtechdev",
                "EMAIL_FROM": "your-email@example.com",
                "EMAIL_PASSWORD": "your-app-password",
                "EMAIL_PORT": "587",
                "SMTP_CLIENTE": "smtp.office365.com"
            },
            "args": []
        }
    ]
}
